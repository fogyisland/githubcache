generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Repository {
  id                    BigInt      @id @default(autoincrement())
  owner                 String      @db.VarChar(100)
  name                  String      @db.VarChar(200)
  // Core fields — was metadata.{description,private,defaultBranch,...}.
  // M27 — these were added without @map annotations, which made Prisma
  // emit camelCase column names that don't exist in the DB (the
  // migration created them as snake_case). @map fixes the mismatch.
  description           String?     @map("description") @db.Text
  private               Boolean     @default(false) @map("private")
  // Nullable at the Prisma layer so existing call sites that don't pass
  // it (test fixtures, stub upserts in queue-on-miss) keep working.
  // The DB column has NOT NULL DEFAULT 'main' so reads always get a
  // value; the backfill in M27.2 will populate it from `metadata` for
  // existing rows.
  defaultBranch         String?     @map("default_branch") @db.VarChar(100)
  stars                 Int         @default(0) @map("stars")
  forks                 Int         @default(0) @map("forks")
  watchers              Int         @default(0) @map("watchers")
  repoCreatedAt         DateTime?   @map("repo_created_at")
  repoUpdatedAt         DateTime?   @map("repo_updated_at")
  repoPushedAt          DateTime?   @map("repo_pushed_at")
  language              String?     @map("language") @db.VarChar(50)
  license               String?     @map("license") @db.VarChar(100)
  topics                Json        @default("[]") @map("topics")
  homepage              String?     @map("homepage") @db.Text
  archived              Boolean     @default(false) @map("archived")
  disabled              Boolean     @default(false) @map("disabled")
  // Legacy JSON columns — dropped in M27.6. Read path in M27.3 falls
  // back to `metadata` when the new columns are NULL (pre-backfill).
  node                  Json
  metadata              Json?
  etag                  String?     @db.VarChar(128)
  // M27.4 — per-facet ETags. Each list endpoint (releases, branches)
  // returns its own ETag; storing them separately lets a 304 on one
  // not poison the other.
  releasesEtag          String?     @map("releases_etag") @db.VarChar(128)
  branchesEtag          String?     @map("branches_etag") @db.VarChar(128)
  lastFetchedAt         DateTime?   @map("last_fetched_at")
  // Per-facet freshness — supersedes lastFetchedAt once backfill runs.
  coreFetchedAt         DateTime?   @map("core_fetched_at")
  releasesFetchedAt     DateTime?   @map("releases_fetched_at")
  branchesFetchedAt    DateTime?   @map("branches_fetched_at")
  fetchStatus           FetchStatus @default(ok) @map("fetch_status")
  fetchError            String?     @map("fetch_error") @db.Text
  createdAt             DateTime    @default(now()) @map("created_at")

  releases              RepoRelease[]
  branches              RepoBranch[]
  refreshJobs           RefreshJob[]

  @@unique([owner, name])
  @@map("repositories")
}

model RepoRelease {
  id           BigInt   @id @default(autoincrement())
  repositoryId BigInt   @map("repository_id")
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  tag          String   @db.VarChar(100)
  name         String?  @db.VarChar(255)
  publishedAt  DateTime @map("published_at")
  prerelease   Boolean  @default(false)
  draft        Boolean  @default(false)
  fetchedAt    DateTime @default(now()) @map("fetched_at")

  @@unique([repositoryId, tag])
  @@index([repositoryId, publishedAt])
  @@map("repo_releases")
}

model RepoBranch {
  id            BigInt   @id @default(autoincrement())
  repositoryId  BigInt   @map("repository_id")
  repository    Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  name          String   @db.VarChar(100)
  protected     Boolean  @default(false)
  lastCommitSha String?  @db.VarChar(64) @map("last_commit_sha")
  fetchedAt     DateTime @default(now()) @map("fetched_at")

  @@unique([repositoryId, name])
  @@map("repo_branches")
}

enum FetchStatus {
  ok
  not_found
  forbidden
  error
}

model User {
  id           BigInt       @id @default(autoincrement())
  email        String       @unique @db.VarChar(255)
  passwordHash String?      @map("password_hash") @db.VarChar(255)
  role         Role         @default(operator)
  status       UserStatus   @default(active) @map("user_status")
  createdAt    DateTime     @default(now()) @map("created_at")
  lastLoginAt  DateTime?    @map("last_login_at")
  theme        Theme        @default(terminal)
  adminVariant AdminVariant @default(mission_control) @map("admin_variant")
  lang         String       @default("zh") @db.VarChar(8)
  // M23 — per-user timezone preference. Nullable so the resolver falls
  // through to DEFAULT_TIMEZONE for newly-created users (no explicit
  // value needed at user creation). Existing rows are backfilled via the
  // migration's DEFAULT clause to 'Asia/Shanghai' — matches the original
  // operator locale and means no operator sees a TZ jump after deploy.
  timezone       String?        @db.VarChar(64) @map("timezone")
  // M26 — how the account was created. `self` = public /signup flow;
  // `invited` = came in through /admin/users/invite and consumed the
  // invite token. Defaults to `self` so the schema-level default matches
  // the new public path; the invite-accept path writes `invited`
  // explicitly. Used by the admin users page to surface the source.
  signupSource   SignupSource   @default(self) @map("signup_source")

  apiKeys      ApiKey[]     @relation("owner")
  approvedKeys ApiKey[]     @relation("approver")
  sessions     Session[]
  invitations  Invitation[] @relation("inviter")

  @@map("users")
}

enum Role {
  admin
  operator
}

enum UserStatus {
  active
  disabled
}

// M26 — tracks how a user account was created. `invited` users were
// created by an admin via /admin/users/invite (and consumed the invite
// token); `self` users created their own account via the public /signup
// page. Admins can filter / see the source from /admin/users.
enum SignupSource {
  invited
  self
}

// Visual theme preference for the public surface. Persisted on User; also
// mirrored to a non-HTTP-only cookie (see src/lib/theme/cookie.ts) so the
// SSR pass can apply `data-theme="<id>"` before the page paints.
enum Theme {
  terminal
  editorial
  brutalist
}

// Visual variant for the admin surface (M11). Three opinionated directions:
// mission_control (ops bridge / radar HUD), inspector (forensic audit),
// workbench (assembly manual). Independent of the public Theme — operator
// can be in workbench admin + editorial public. Mirrored to a non-HTTP-only
// cookie (see src/lib/admin/cookie.ts) so the SSR pass can apply
// `data-admin="<id>"` before paint.
enum AdminVariant {
  mission_control @map("mission_control")
  inspector
  workbench
}

model ApiKey {
  id              BigInt       @id @default(autoincrement())
  userId          BigInt       @map("user_id")
  user            User         @relation("owner", fields: [userId], references: [id])
  name            String       @db.VarChar(100)
  keyPrefix       String       @map("key_prefix") @db.VarChar(16)
  keyHash         String       @unique @map("key_hash") @db.VarChar(64)
  status          ApiKeyStatus @default(pending)
  rateLimitPerMin Int          @default(60) @map("rate_limit_per_min")
  dailyQuota      Int          @default(10000) @map("daily_quota")
  createdAt       DateTime     @default(now()) @map("created_at")
  approvedAt      DateTime?    @map("approved_at")
  approvedBy      BigInt?      @map("approved_by")
  approver        User?        @relation("approver", fields: [approvedBy], references: [id])
  revokedAt       DateTime?    @map("revoked_at")
  lastUsedAt      DateTime?    @map("last_used_at")

  rateLimitBuckets RateLimitBucket[]

  @@index([status])
  @@map("api_keys")
}

enum ApiKeyStatus {
  pending
  active
  revoked
}

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  actorUserId BigInt   @map("actor_user_id")
  action      String   @db.VarChar(100)
  targetType  String   @map("target_type") @db.VarChar(50)
  targetId    String   @map("target_id") @db.VarChar(100)
  metadata    Json?
  ip          String?  @db.VarChar(45)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([action])
  @@index([createdAt])
  @@map("audit_log")
}

model RequestLog {
  id            BigInt   @id @default(autoincrement())
  apiKeyId      BigInt?  @map("api_key_id")
  endpoint      String   @db.VarChar(100)
  repoRequested String?  @map("repo_requested") @db.VarChar(300)
  cacheHit      Boolean  @map("cache_hit")
  durationMs    Int      @map("duration_ms")
  statusCode    Int      @map("status_code")
  ip            String?  @db.VarChar(45)
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([apiKeyId, createdAt])
  @@map("request_log")
}

// M21 — DB-direct GitHub token storage. The `token` column stores the
// raw plaintext PAT so initPool() can construct Octokit clients without
// requiring env-var/file + restart. THREAT MODEL: a DB dump exposes
// GitHub tokens — anyone with the dump can act as the user against the
// GitHub API. Same trade-off as `webhook_subscriptions.secret` (M14).
// Mitigation: DB access ACLs + SQL backup encryption. We do NOT hash
// because we need the raw bytes for Bearer auth.
//
// Legacy M4 rows have `token = NULL` — operator must re-add via UI.
model GithubToken {
  id            BigInt            @id @default(autoincrement())
  label         String            @db.VarChar(100)
  tokenFirst4   String            @map("token_first4") @db.Char(4)
  tokenLast4    String            @map("token_last4") @db.Char(4)
  tokenHash     String            @unique @map("token_hash") @db.Char(64)
  token         String?           @map("token") @db.Text
  status        GithubTokenStatus @default(active)
  requestsUsed  Int               @default(0) @map("requests_used")
  requestsLimit Int               @default(5000) @map("requests_limit")
  resetAt       DateTime?         @map("reset_at")
  lastUsedAt    DateTime?         @map("last_used_at")
  createdAt     DateTime          @default(now()) @map("created_at")

  @@map("github_tokens")
}

enum GithubTokenStatus {
  active
  disabled
}

model RefreshJob {
  id           BigInt           @id @default(autoincrement())
  repositoryId BigInt           @map("repository_id")
  // M27 — what facet this job refreshes. Existing rows default to
  // 'core' (full re-fetch). M27.5 starts enqueuing 'releases' / 'branches'
  // per facet cadence.
  kind         RefreshJobKind   @default(core) @map("job_kind")
  priority     Int              @default(50)
  scheduledFor DateTime         @map("scheduled_for")
  status       RefreshJobStatus @default(pending)
  attempts     Int              @default(0)
  lastError    String?          @map("last_error") @db.Text
  lockedUntil  DateTime?        @map("locked_until")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  repository   Repository       @relation(fields: [repositoryId], references: [id])

  @@index([status, scheduledFor])
  @@index([status, priority])
  @@map("refresh_jobs")
}

enum RefreshJobKind {
  core
  releases
  branches
}

enum RefreshJobStatus {
  pending
  in_progress
  done
  failed
}

model Session {
  id        String   @id @db.Char(43)
  userId    BigInt   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  ip        String?  @db.VarChar(45)
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("sessions")
}

model Invitation {
  id         String    @id @db.Char(32)
  email      String    @db.VarChar(255)
  role       Role
  invitedBy  BigInt    @map("invited_by")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  inviter    User      @relation("inviter", fields: [invitedBy], references: [id])

  @@index([email])
  @@map("invitations")
}

model RateLimitBucket {
  id          BigInt   @id @default(autoincrement())
  apiKeyId    BigInt   @map("api_key_id")
  // Sliding window state. Window length is fixed at 60s by the rate-limit
  // semantics; we store the timestamp of the current window's start.
  windowStart DateTime @map("window_start")
  count       Int      @default(0)
  apiKey      ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([apiKeyId])
  @@index([windowStart])
  @@map("rate_limit_buckets")
}

// Parallel to RateLimitBucket but keyed by client IP. Used by the public
// lookup form (/, /repo/[owner]/[name]) where callers do not bring an
// X-API-Key. Per-IP limits (PUBLIC_LOOKUP_RATE_PER_MIN env) protect the
// GitHub token pool from anonymous abuse.
model IpRateLimitBucket {
  id          BigInt   @id @default(autoincrement())
  ip          String   @unique @db.VarChar(45)
  windowStart DateTime @map("window_start")
  count       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([windowStart])
  @@map("ip_rate_limit_buckets")
}

// M14.6 — operator-facing system event webhooks. The webhook layer is a
// consumer of the audit log: every AuditLog row can be fanned out to N
// WebhookSubscriptions whose eventFilter matches the audit action. Each
// fan-out becomes a WebhookDelivery that the delivery worker retries with
// exponential backoff until success, max-attempts (dead), or manual
// re-arm.
//
// `secret` stores the raw 32-byte hex signing key. It's shown exactly
// once at creation/rotation time and never recoverable from the DB
// after that. THREAT MODEL: a DB dump exposes signing keys — anyone
// with the dump can forge events to that subscriber. This is the same
// tradeoff GitHub/Stripe make (they also store raw). Mitigation: limit
// DB access via standard ACLs. We do NOT hash the secret because we
// need the raw bytes to sign each delivery.
//
// `eventFilter` is a JSON array of action strings or the single
// element `["*"]` for firehose mode. `active` is set false
// automatically when a delivery hits `dead` so the admin UI shows the
// failure clearly without silently swallowing new events.
model WebhookSubscription {
  id                 BigInt    @id @default(autoincrement())
  url                String    @db.VarChar(500)
  secret             String    @db.Char(64)
  eventFilter        Json      @map("event_filter")
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now()) @map("created_at")
  lastDeliveryAt     DateTime? @map("last_delivery_at")
  lastDeliveryStatus String?   @map("last_delivery_status") @db.VarChar(20)
  createdBy          BigInt?   @map("created_by")

  deliveries WebhookDelivery[]

  @@index([active])
  @@map("webhook_subscriptions")
}

// M14.6 — one row per (subscription × audit event) emission. The payload
// is a frozen JSON snapshot of the AuditLog row + the subscription URL
// so the delivery worker can replay retries without re-reading the
// AuditLog (which may be pruned by retention policy). `attemptCount`
// increments on every HTTP attempt; `status` advances pending → delivered
// or pending → failed (transient) → dead (after max attempts). The
// delivery worker picks up `pending` rows where `nextRetryAt <= now()`
// and processes them FIFO (oldest first).
model WebhookDelivery {
  id              BigInt    @id @default(autoincrement())
  subscriptionId  BigInt    @map("subscription_id")
  subscription    WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  eventId         BigInt    @map("event_id")
  eventAction     String    @map("event_action") @db.VarChar(100)
  eventTargetType String    @map("event_target_type") @db.VarChar(50)
  eventTargetId   String    @map("event_target_id") @db.VarChar(100)
  eventCreatedAt  DateTime  @map("event_created_at")
  payload         Json
  attemptCount    Int       @default(0) @map("attempt_count")
  status          WebhookDeliveryStatus @default(pending)
  lastAttemptAt   DateTime? @map("last_attempt_at")
  lastError       String?   @map("last_error") @db.Text
  nextRetryAt     DateTime? @map("next_retry_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([status, nextRetryAt])
  @@index([subscriptionId, createdAt])
  @@map("webhook_deliveries")
}

enum WebhookDeliveryStatus {
  pending
  delivered
  failed
  dead
}

// M19 — JSON-driven ingestion sources. Operators register providers that
// point at a JSON file (or HTTP endpoint) containing a list of GitHub
// repository URLs. /admin/ingestion can then "preview" the provider to
// see how many unique owner/name pairs will be queued and "run" to
// enqueue refresh_jobs for any that are not already cached.
//
// `sourceType` is reserved for future expansion (csv, rss, html scrape).
// For M19 only 'json' is accepted by the API and the run path.
//
// `configJson` is validated against `ProviderConfigSchema` (see
// src/lib/ingestion/providers/schema.ts) at every API boundary, so
// raw DB rows are never trusted at read time — always re-parse.
model IngestionProvider {
  id         BigInt   @id @default(autoincrement())
  slug       String   @unique @db.VarChar(64)
  name       String   @db.VarChar(128)
  sourceType String   @default("json") @map("source_type") @db.VarChar(32)
  configJson Json     @map("config_json")
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("ingestion_providers")
}

// M25 — SMTP credentials + sender identity. Single-row table (id=1 only,
// enforced by CHECK constraint). smtp_pass stored PLAINTEXT (same threat
// model as M21's github_tokens.token — DB dump exposes the SMTP password
// and lets the dump reader impersonate our sender. We need the raw bytes
// for SMTP AUTH. Mitigation: DB ACLs + SQL backup encryption.)
model EmailConfig {
  id         Int      @id @default(1)
  smtpHost   String   @map("smtp_host") @db.VarChar(255)
  smtpPort   Int      @map("smtp_port")
  smtpUser   String   @map("smtp_user") @db.VarChar(255)
  smtpPass   String   @map("smtp_pass") @db.Text
  smtpSecure Boolean  @default(false) @map("smtp_secure")
  smtpFrom   String   @map("smtp_from") @db.VarChar(255)
  replyTo    String?  @map("reply_to") @db.VarChar(255)
  updatedAt  DateTime @updatedAt @map("updated_at")
  updatedBy  BigInt?  @map("updated_by")

  @@map("email_config")
}

// M25 — append-only send log. status: queued (default at insert) →
// sent (after nodemailer succeeds) or failed (after exception).
// errorMessage truncated to 1000 chars at insert time.
model EmailLog {
  id                BigInt         @id @default(autoincrement())
  recipient         String         @db.VarChar(255)
  subject           String         @db.VarChar(500)
  templateKey       String         @map("template_key") @db.VarChar(100)
  status            EmailLogStatus @default(queued)
  errorMessage      String?        @map("error_message") @db.Text
  relatedEntityType String?        @map("related_entity_type") @db.VarChar(50)
  relatedEntityId   String?        @map("related_entity_id") @db.VarChar(100)
  sentAt            DateTime?      @map("sent_at")
  createdAt         DateTime       @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@index([recipient, createdAt])
  @@index([relatedEntityType, relatedEntityId])
  @@map("email_log")
}

enum EmailLogStatus {
  queued
  sent
  failed
}
