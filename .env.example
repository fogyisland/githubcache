DATABASE_URL=mysql://user:pass@localhost:3306/githubcache
PORT=3000
LOG_LEVEL=info
SESSION_SECRET=replace-with-32-chars-min-secret
NODE_ENV=development
# GITHUB_TOKEN=ghp_xxx   # legacy single-token (M1); M4 prefers GITHUB_TOKENS or GITHUB_TOKENS_FILE
# GITHUB_TOKENS=ghp_aaa,ghp_bbb,ghp_ccc   # comma-separated tokens (M4 pool). Mutually exclusive with GITHUB_TOKENS_FILE.
# GITHUB_TOKENS_FILE=/run/secrets/github_tokens   # one token per line (M4 pool). Takes precedence over GITHUB_TOKENS if set.
