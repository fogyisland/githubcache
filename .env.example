DATABASE_URL=mysql://user:pass@localhost:3306/githubcache
PORT=3000
LOG_LEVEL=info
SESSION_SECRET=replace-with-32-chars-min-secret
# NODE_ENV — production for deployed instances, 'development' for local dev.
# The init script (scripts/init.ts) forces this to 'production' on non-interactive
# deploys regardless of what this template says. Local devs should change it to
# 'development' AFTER running `npm run init` if you want React's dev bundle.
# M32.7.4: flipped from 'development' to 'production' — fresh deploys no longer
# inherit the wrong NODE_ENV via `scripts/init.ts:200` (copyFileSync .env.example → .env).
NODE_ENV=production

# Optional scheduler knobs (defaults shown — uncomment to override)
# SCHEDULER_BATCH_SIZE=10          # refresh jobs claimed per tick
# SCHEDULER_TICK_MS=60000          # tick interval in ms
# NIGHTLY_SWEEP_INTERVAL_MS=86400000  # full re-check interval in ms (24h)
# SCHEDULER_ENABLED=true           # set false to disable background refresh
