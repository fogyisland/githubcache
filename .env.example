DATABASE_URL=mysql://user:pass@localhost:3306/githubcache
# PORT — defaults to 5002 from package.json `dev:port` field via
# src/lib/config/dev-port.ts (the single source of truth). next dev /
# next start / dev:server all use that constant. Override here ONLY
# if your machine has a port conflict; keep in sync with `dev:port`
# in package.json otherwise.
# PORT=5002
LOG_LEVEL=info
SESSION_SECRET=replace-with-32-chars-min-secret
# NODE_ENV — production for deployed instances, 'development' for local dev.
# The init script (scripts/init.ts) forces this to 'production' on non-interactive
# deploys regardless of what this template says. Local devs should change it to
# 'development' AFTER running `npm run init` if you want React's dev bundle.
# M32.7.4: flipped from 'development' to 'production' — fresh deploys no longer
# inherit the wrong NODE_ENV via `scripts/init.ts:200` (copyFileSync .env.example → .env).
NODE_ENV=production

# Optional scheduler knobs (defaults shown — uncomment to override)
# M32.7.4 — default tick interval reduced from 60000ms (60s) to 1000ms (1s).
# At batch_size=1 this gives ~1 req/sec steady-state, well under GitHub PAT's
# 5000/h limit (~1.4/s). 60s was too slow for back-filling a 3818-job backlog
# (would take hours); 1s drains in ~64 min. Override SCHEDULER_BATCH_SIZE too
# if you have multiple GitHub tokens — multiply tokens × tick budget.
SCHEDULER_BATCH_SIZE=1            # refresh jobs claimed per tick
SCHEDULER_TICK_MS=1000            # tick interval in ms — 1s = steady 1 req/s
# NIGHTLY_SWEEP_INTERVAL_MS=86400000  # full re-check interval in ms (24h)
# SCHEDULER_ENABLED=true           # set false to disable background refresh
