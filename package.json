{
  "name": "githubcache",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "author": {
    "name": "fogyisland",
    "url": "https://github.com/fogyisland"
  },
  "homepage": "https://github.com/fogyisland/githubcache",
  "repository": {
    "type": "git",
    "url": "https://github.com/fogyisland/githubcache.git"
  },
  "bugs": {
    "url": "https://github.com/fogyisland/githubcache/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "node -e \"const fs=require('fs');if(fs.existsSync('.next')){console.log('→ wiping stale .next/ before dev');fs.rmSync('.next',{recursive:true,force:true})};\"",
    "dev": "next dev -p 5002",
    "dev:fresh": "node scripts/dev-fresh.cjs",
    "dev:server": "tsx src/server.ts",
    "prebuild": "node -e \"const fs=require('fs');if(fs.existsSync('.next')){console.log('→ wiping stale .next/ before build');fs.rmSync('.next',{recursive:true,force:true})};\"",
    "build": "next build",
    "start": "next start -p 5002",
    "start:server": "tsx src/bootstrap.ts",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "dev:fetch": "tsx scripts/dev-fetch.ts",
    "create:admin": "tsx --env-file=.env scripts/create-admin.ts",
    "db:check-drift": "tsx --env-file=.env scripts/db-drift-check.ts",
    "db:migrate": "prisma migrate deploy",
    "db:resolve-rolled-back": "tsx scripts/resolve-rolled-back-migrations.ts",
    "init": "tsx scripts/init.ts",
    "mint:key": "tsx --env-file=.env scripts/mint-local-api-key.ts",
    "smoke:session": "tsx --env-file=.env scripts/smoke-session.ts",
    "release": "tsx scripts/release.ts"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "@prisma/client": "5",
    "bcrypt": "^6.0.0",
    "next": "^15.0.0",
    "next-intl": "^4.14.1",
    "nodemailer": "^7.0.13",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@rushstack/eslint-patch": "^1.16.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "20",
    "@types/nodemailer": "^7.0.12",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv": "^17.4.2",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.0.0",
    "msw": "^2.15.0",
    "postcss": "^8.5.26",
    "prettier": "3",
    "prisma": "5",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "5.4",
    "vitest": "^4.1.11"
  },
  "msw": {
    "workerDirectory": [
      "tests"
    ]
  },
  "overrides": {
    "web-vitals": "^4.2.4"
  }
}
