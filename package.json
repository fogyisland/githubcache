{
  "name": "githubcache",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev -p 5002",
    "dev:server": "tsx watch --env-file=.env src/server.ts",
    "start:server": "node --import tsx/esm --env-file=.env src/server.ts",
    "build": "next build",
    "start": "next start -p 5002",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "dev:fetch": "tsx scripts/dev-fetch.ts",
    "create:admin": "tsx --env-file=.env scripts/create-admin.ts",
    "smoke:session": "tsx --env-file=.env scripts/smoke-session.ts"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "@prisma/client": "5",
    "bcrypt": "^6.0.0",
    "next": "14",
    "next-intl": "^4.14.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "18",
    "react-dom": "18",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "20",
    "@types/react": "18",
    "@types/react-dom": "18",
    "@vitest/coverage-v8": "1",
    "dotenv": "^17.4.2",
    "eslint": "9",
    "eslint-config-next": "^16.3.1",
    "msw": "^2.15.0",
    "postcss": "^8.5.26",
    "prettier": "3",
    "prisma": "5",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "5.4",
    "vitest": "1"
  },
  "msw": {
    "workerDirectory": [
      "tests"
    ]
  }
}
