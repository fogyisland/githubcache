# M28.bug10 — build-time stub.
# Loaded by Next.js only when NODE_ENV=production during `npm run build`.
# Provides a syntactically valid DATABASE_URL so env.ts Zod validation
# passes when route handlers reach for env.DATABASE_URL during the
# "Collecting page data" step. The real connection string is written by
# `npm run init` after build, before the server actually starts serving
# requests.
DATABASE_URL=mysql://stub:stub@localhost:3306/stub
PORT=5002
LOG_LEVEL=info
SESSION_SECRET=build-time-stub-32-chars-min-padding-aaaaa
NODE_ENV=production