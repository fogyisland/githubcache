# Build-time stub for npm run build.
#
# Loaded by Next.js when NODE_ENV=production (which is what next build sets
# internally). Provides a syntactically-valid DATABASE_URL so env.ts Zod
# validation passes during the build's page-data collection phase.
#
# This URL is INVALID — it doesn't route to anything. Any actual DB query
# during runtime will fail immediately with a connection error, surfacing
# the problem before the user does anything. /init writes the real
# DATABASE_URL to .env, which Next.js then loads instead of this stub.
#
# Why the URL is gibberish rather than a localhost stub: a localhost stub
# would silently succeed at boot if MySQL happened to be running locally
# with no auth (the test machine's MySQL 5.7.44 accepts root@localhost).
# The .invalid TLD is reserved by RFC 2606 and guaranteed to never resolve.
PORT=5002
LOG_LEVEL=info
SESSION_SECRET=build-time-stub-32-chars-min-padding-aaaaa
NODE_ENV=production
DATABASE_URL=mysql://stub:stub@stub.invalid:3306/stub